# Between the editor and what stores a session's record. The editor may send its own activity
# events, read its own coding-time counter (the one in the status bar) and hand in its changes
# (`submit`), and nothing else: no dashboard, no sign-up, no settings, no way to read anyone's
# data. Neither Wakapi nor the collector is on the editor's network, so this is the only door.
{
	admin off
	auto_https off
}

:3000 {
	@send {
		method POST
		path /api/users/current/heartbeats.bulk /api/users/current/heartbeats
	}
	@counter {
		method GET
		path /api/users/current/statusbar/today
	}
	@submit {
		method POST
		path /submit
	}

	handle @submit {
		request_body {
			max_size 5MB
		}
		reverse_proxy collector:8000
	}

	handle @send {
		request_body {
			max_size 1MB
		}
		reverse_proxy wakapi:3000
	}

	handle @counter {
		reverse_proxy wakapi:3000
	}

	handle {
		respond "Not allowed" 403
	}
}
